# Pam server config. Copy to server/.env (gitignored). Everything is optional
# except DEEPGRAM_API_KEY — each feature degrades gracefully without its keys.

# REQUIRED for voice. console.deepgram.com -> API Keys -> create with Member role
# (Member+ is needed to mint the short-lived browser tokens via /v1/auth/grant).
# New accounts get ~$200 free credit; the agent costs ~$4.50/hr.
DEEPGRAM_API_KEY=

# Where find_object searches. Without this it scans MEMORY_JSONL directly.
# cloud.elastic.co -> 14-day trial, no card -> copy the HTTPS endpoint.
# Auth: either put elastic:<password> in the URL, or set ELASTICSEARCH_API_KEY.
ELASTICSEARCH_URL=https://<deployment>.elastic.cloud
ELASTICSEARCH_API_KEY=
# Path to the pipeline's memory log. Defaults to perception/runs/live/memory.jsonl
MEMORY_JSONL=

# Google Calendar -> Settings -> "Secret address in iCal format". Read-only, no OAuth.
# Without it, server/demo.ics is used.
CALENDAR_ICS_URL=

# Twilio trial (~15 min): silent SMS + call bridging. Trial accounts can only reach
# VERIFIED numbers — verify teammates' phones in the console. Without these,
# send_message/call_contact render tel:/sms: confirm cards instead.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=          # your Twilio number, +1...
USER_PHONE=           # the demo phone's real number (receives bridged calls)

# Amadeus Self-Service test keys (free): real flight offers in search_flights.
# Without them it returns a prefilled Google Flights link.
AMADEUS_KEY=
AMADEUS_SECRET=

# Home location: weather + ride pickup. Default is MIT campus.
HOME_LAT=42.3601
HOME_LON=-71.0942

# VLA policy server for fetch_object (default http://127.0.0.1:8020)
ARM_URL=

# Where vlm.py posts memories for ES indexing (default http://127.0.0.1:8000)
PAM_SERVER=
GOOGLE_MAPS_API_KEY
